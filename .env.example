# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Salesforce OAuth
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REDIRECT_URI=http://localhost:3001/auth/salesforce/callback
SF_LOGIN_URL=https://login.salesforce.com

# Optional target-org OAuth override for org-scoped External Client Apps
SF_TARGET_CLIENT_ID=
SF_TARGET_CLIENT_SECRET=
SF_TARGET_REDIRECT_URI=http://localhost:3001/auth/salesforce/callback
SF_TARGET_LOGIN_URL=https://your-target-org.my.salesforce.com

# Redis
REDIS_URL=redis://localhost:6379

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=orgiq-migrations

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Claude API
ANTHROPIC_API_KEY=

# Salesforce MCP Server
# The MCP server URL is found in Salesforce Setup → Integrations → MCP Server.
# Format: https://<instance>.my.salesforce.com/services/mcp/sse
# Each connected org's URL is stored in connected_orgs.mcp_server_url.
# The vars below are stubs for local dev — production reads from Supabase.
SF_MCP_SERVER_URL=https://yourorg.my.salesforce.com/services/mcp/sse
SF_ACCESS_TOKEN_STUB=

# Internal service URL — used by the Python engine to call the MCP schema endpoint.
# In production this points to the backend container on the internal Docker network.
MCP_SERVICE_URL=http://localhost:3001

# App
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
